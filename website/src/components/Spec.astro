---
// One specialization: its strong points as an exploded stack of plates, then a section for each.
// Built from the UI kit in ./ui/ (shown on /kit/); this file only says what goes in it.
import Page from './Page.astro';
import Stack from './ui/Stack.astro';
import InfoPanel from './ui/InfoPanel.astro';
import Section from './ui/Section.astro';
import StatusTag from './ui/StatusTag.astro';
import { WORDS, SLUGS, href, type Lang, type Slug } from '../data/site';
import { POINT_MOTIFS } from '../data/motifs';
interface Props { lang: Lang; slug: Slug }
const { lang, slug } = Astro.props;
const w = WORDS[lang];
const s = w.specs[slug];
const n = SLUGS.indexOf(slug) + 1;
const hint = `0${n} ${s.name} · ` + w.hintSpec.replace('{n}', String(s.points.length));
const label = (i: number) => `${w.plate} ${n}.${i + 1}`;
---
<Page lang={lang} slug={slug} kind="spec" title={`${s.name} · Curva`} description={s.lede} hint={hint}>
	<Fragment slot="left">
		<a class="back mono" href={href(lang)}>{w.back}</a>
		<StatusTag text={s.live ? s.status : `${s.status} · ${w.notYet}`} live={s.live} />
		<h1 class:list={['spec-name', { long: s.name.length > 8 }]}>{s.name}</h1>
		<p class="spec-line">{s.line}</p>
		<p class="lede">{s.lede}</p>
	</Fragment>
	<Stack slot="stack" plates={s.points.map((p, i) => ({
		href: `#p${i + 1}`, tag: `${n}.${i + 1}`, name: p.short, drawing: POINT_MOTIFS[slug][i],
	}))} />
	<InfoPanel slot="info" items={s.points.map((p, i) => ({ label: label(i), title: p.title, text: p.text }))} />
	<Fragment slot="sections">
		{s.points.map((p, i) => (
			<Section id={`p${i + 1}`} label={label(i)} title={p.title} point body={p.text} drawing={POINT_MOTIFS[slug][i]} />
		))}
		<section class="band others">
			<h2 class="point">{w.others}</h2>
			<nav class="switch" aria-label={w.others}>
				{SLUGS.map((o, i) => (
					<a href={href(lang, o)} aria-current={o === slug ? 'page' : undefined}>
						<span>0{i + 1} {w.specs[o].name}</span>
						<span class="mono">{w.specs[o].status}</span>
					</a>
				))}
			</nav>
		</section>
	</Fragment>
</Page>
