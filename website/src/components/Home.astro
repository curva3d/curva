---
// The home page: the five specializations as an exploded stack of plates, then a section for each.
// Built from the UI kit in ./ui/ (shown on /kit/); this file only says what goes in it.
import Page from './Page.astro';
import Stack from './ui/Stack.astro';
import InfoPanel from './ui/InfoPanel.astro';
import Section from './ui/Section.astro';
import { WORDS, SLUGS, href, type Lang } from '../data/site';
import { MOTIFS } from '../data/motifs';
interface Props { lang: Lang }
const { lang } = Astro.props;
const w = WORDS[lang];
const num = (i: number) => `0${i + 1} · `;
---
<Page lang={lang} kind="home" title={w.title} description={w.description} hint={w.hintHome}>
	<Fragment slot="left">
		<h1 class="motto">{w.motto}</h1>
		<p class="intro">{w.intro}</p>
	</Fragment>
	<Stack slot="stack" plates={SLUGS.map((s, i) => ({
		href: `#${s}`, tag: num(i) + w.specs[s].status, name: w.specs[s].name, drawing: MOTIFS[s],
	}))} />
	<InfoPanel slot="info" items={SLUGS.map((s) => ({
		label: w.specs[s].status, name: w.specs[s].name, line: w.specs[s].line, bullets: w.specs[s].bullets,
	}))} />
	<Fragment slot="sections">
		{SLUGS.map((s, i) => (
			<Section id={s} status live={w.specs[s].live} label={num(i) + w.specs[s].status}
				title={w.specs[s].name} line={w.specs[s].line} body={w.specs[s].lede} bullets={w.specs[s].bullets}
				button={{ href: href(lang, s), text: w.explore.replace('{name}', w.specs[s].name) }}
				drawing={MOTIFS[s]} />
		))}
	</Fragment>
</Page>
