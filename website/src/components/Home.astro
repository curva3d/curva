---
// The home page: the four specializations as an exploded stack of plates, then a section for each.
import Page from './Page.astro';
import { WORDS, SLUGS, href, type Lang } from '../data/site';
import { MOTIFS } from '../data/motifs';
interface Props { lang: Lang }
const { lang } = Astro.props;
const w = WORDS[lang];
---
<Page lang={lang} kind="home" title={w.title} description={w.description} hint={w.hintHome}>
	<Fragment slot="left">
		<h1 class="motto">{w.motto}</h1>
		<p class="intro">{w.intro}</p>
	</Fragment>
	<div class="persp" slot="stack"><div class="stack">
		{SLUGS.map((s, i) => (
			<a class="plate glass" href={`#${s}`} data-plate={i}>
				<span class="tag mono">0{i + 1} · {w.specs[s].status}</span>
				<span class="name">{w.specs[s].name}</span>
				<Fragment set:html={MOTIFS[s]} />
			</a>
		))}
	</div></div>
	<div class="info glass" slot="info" aria-hidden="true">
		{SLUGS.map((s, i) => (
			<div class:list={['info-item', { on: i === 0 }]} data-info={i}>
				<span class="mono">{w.specs[s].status}</span>
				<span class="info-name">{w.specs[s].name}</span>
				<strong class="info-line">{w.specs[s].line}</strong>
				<ul>{w.specs[s].bullets.map((b) => <li>{b}</li>)}</ul>
			</div>
		))}
	</div>
	<Fragment slot="sections">
		{SLUGS.map((s, i) => (
			<section class="band" id={s}>
				<div class="band-text">
					<p class:list={['status', 'mono', { live: w.specs[s].live }]}>0{i + 1} · {w.specs[s].status}</p>
					<h2>{w.specs[s].name}</h2>
					<p class="band-line">{w.specs[s].line}</p>
					<p class="band-body">{w.specs[s].lede}</p>
					<ul>{w.specs[s].bullets.map((b) => <li>{b}</li>)}</ul>
					<a class="go" href={href(lang, s)}>{w.explore.replace('{name}', w.specs[s].name)}</a>
				</div>
				<div class="shot mono">{w.shot}</div>
			</section>
		))}
	</Fragment>
</Page>
